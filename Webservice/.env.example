# 数据库配置
# SQLite（默认，适合开发和小规模部署）
DATABASE_URL=sqlite:///./license.db
# PostgreSQL（生产环境推荐）
# DATABASE_URL=postgresql://license_user:license_pass@localhost:5432/license_db

# 应用配置
APP_NAME=License Authorization Service
APP_VERSION=1.0.0
DEBUG=True
SECRET_KEY=your-secret-key-change-this-in-production

# 服务器配置
HOST=0.0.0.0
PORT=8000

# CORS配置 (JSON数组格式)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8080"]

# JWT配置
JWT_SECRET_KEY=your-secret-key-here-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# 默认管理员配置（首次启动时自动创建）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_EMAIL=admin@example.com

# 主密钥（用于加密应用的PassPhrase）
MASTER_ENCRYPTION_KEY=your-master-key-change-this-in-production

# 邮件配置
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=your-email@gmail.com
FROM_NAME=License Service

# Stripe支付配置
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
# Stripe 异步回调签名密钥（Dashboard -> Webhooks -> Signing secret）
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# 支付宝支付配置
ALIPAY_APP_ID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=alipay_public_key

# 微信支付配置
WECHAT_APP_ID=your_wechat_app_id
WECHAT_MCH_ID=your_wechat_mch_id
WECHAT_API_KEY=your_wechat_api_key

# 日志配置
LOG_LEVEL=INFO
